# ==============================================================================
# AI PALMISTRY & TAROT INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend/ or workproj/ and supply your actual credentials.
# Do NOT commit your actual .env file or credentials to Git.

# Application Timezone (Configured to Asia/Kolkata per specifications)
APP_TIMEZONE=Asia/Kolkata

# Google Cloud OAuth 2.0 Credentials (For Google Sign-In & ID Token Verification)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Calendar & Google Meet OAuth Redirect URI
# Must match Authorized Redirect URIs in your Google Cloud Console Web Application Client
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/calendar/callback

# Frontend URL (For CORS and OAuth callback redirects)
FRONTEND_URL=http://localhost:5173
