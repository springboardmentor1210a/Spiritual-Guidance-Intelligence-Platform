rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and subcollections:
    // Read user profiles for authenticated sessions/admin; write isolated to user
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      
      match /palm_readings/{readingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /tarot_readings/{readingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null;
      }
    }
    
    // Global System Announcements: readable and writable by authenticated users/admins
    match /system_announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }
    
    // Sessions: allow participants and authenticated users to read and update
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Consultations: allow authenticated users to read and manage consultations
    match /consultations/{consultationId} {
      allow read, write: if request.auth != null;
    }

    // Readings: global readings collection for admin and analytics
    match /readings/{readingId} {
      allow read, write: if request.auth != null;
    }

    // Consultants directory
    match /consultants/{consultantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Guidance requests
    match /guidance_requests/{reqId} {
      allow read, write: if request.auth != null;
    }
    
    // Dedicated Consultation Chat Threads:
    // Restrict read/write access ONLY to the specific participant User ID and Consultant ID involved in that session
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants ||
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.expertId ||
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.expertId
      );

      // Embedded messages within the consultation chat thread
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          request.auth.uid == request.resource.data.senderId
        );
      }
    }
  }
}
